# ── Discord ──────────────────────────────────────────────────────────────────
# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# The channel ID where match announcements will be posted
# Right-click a channel → Copy Channel ID (Developer Mode must be on)
ANNOUNCE_CHANNEL_ID=your_channel_id_here

# ── Football API ──────────────────────────────────────────────────────────────
# Free tier available at https://www.api-football.com/
# World Cup 2026 = League ID 1, Season 2026
FOOTBALL_API_KEY=your_api_football_key_here
